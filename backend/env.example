# Backend environment configuration (HR ticketing system).
#
# HOW TO USE:  copy this file as "backend/.env" and adjust the values for your
# machine. The FastAPI settings loader (app/core/config.py) reads them.
#
# NOTE: the repo .gitignore already excludes .env / .env.* so secrets never
# get committed. If you never copy this file, the app still runs — the
# defaults in app/core/config.py point at a local SQLite database.

# Default: local SQLite file next to backend/. The file is created and
# demo-seeded automatically on first boot. Nothing to install. (default below
# matches the shipped default, so you may simply not have a .env at all)
DATABASE_URL=sqlite:///./hr_ticketing.db

# To use a real MySQL server instead: point the URL at it and install the
# MySQL driver (uncomment PyMySQL + cryptography in backend/requirements.txt):
#   Is your MySQL account passwordless (common with XAMPP installs)? Keep the
#   colon+nothing:  mysql+pymysql://root:@localhost:3306/hr_ticketing?charset=utf8mb4
#   With a password:              mysql+pymysql://root:YourPassword@localhost:3306/hr_ticketing?charset=utf8mb4
# (The app auto-runs CREATE DATABASE IF NOT EXISTS at startup, so you do not
#  need to create the hr_ticketing database by hand.)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/hr_ticketing?charset=utf8mb4

# Vite dev server origin (vite.config.js runs on 5173) that is allowed to
# call this API from the browser. localhost and 127.0.0.1 both included.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port the backend listens on when started via python -m app.main (default 8000).
BACKEND_PORT=8000
